[Unit]
Description=Deriv Signal Assistant - always-on signal-only scanner
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=derivscanner
Group=derivscanner
WorkingDirectory=/opt/deriv-bot
EnvironmentFile=/etc/deriv-scanner.env
Environment=SCANNER_DATA_DIR=/var/lib/deriv-scanner
RuntimeDirectory=deriv-scanner
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --nonblock /run/deriv-scanner/scanner.lock /usr/bin/node /opt/deriv-bot/scanner_supervisor.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/deriv-scanner /run/deriv-scanner

[Install]
WantedBy=multi-user.target
