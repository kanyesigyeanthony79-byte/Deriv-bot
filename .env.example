# Copy to .env locally. Never commit .env or share your token.
DERIV_TOKEN=
DERIV_ACCOUNT_ID=
# Required when using a Personal Access Token (PAT); optional for OAuth.
DERIV_APP_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RELAY_PASSCODE=

# Trading remains OFF by default. The connection-check script is read-only.
TRADE_ENABLED=false
TRADE_MODE=demo
STAKE=1
CURRENCY=USD
TRADE_DURATION_CANDLES=4
MAX_TRADES_PER_DAY=3
MAX_OPEN_TRADES=2
MAX_DAILY_LOSS=3
MIN_PAYOUT_RATIO=0.6
